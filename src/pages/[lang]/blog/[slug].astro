---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";

import { getEntries, getEntryById } from "@/lib/contentful";
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";

export async function getStaticPaths() {
  const locales = ["en", "ar"];
  const paths = [];

  for (const locale of locales) {
    const entries = await getEntries(
      "blog",
      locale === "ar" ? "ar-SA" : "en-US"
    );

    for (const entry of entries) {
      // Extract just the slug without language prefix
      const slug = entry.slug.split("/").pop() || entry.slug;

      paths.push({
        params: {
          lang: locale,
          slug: slug,
        },
        props: { entry },
      });
    }
  }

  //console.log('Generated paths:', paths);
  return paths;
}

const { entry } = Astro.props;
const { lang, slug } = Astro.params;

//extract entry fields
const { title, summary, details, postThumbnail, tags, category } = entry;

//const tagsArray = tags.map((tag) => tag.fields.title.trim());
//const categoriesArray = category.map((cat) => cat.fields.title.trim());

//render rich text to HTML
const pageDetails = documentToHtmlString(details);
