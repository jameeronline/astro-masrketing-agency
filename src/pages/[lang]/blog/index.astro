---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import BlogList from '@components/BlogList.astro';

//contentful imports
import { getEntries } from '@/lib/contentful';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } }
  ];
}

const { lang } = Astro.params;

//get all the blog post
const entries = await getEntries('blog', lang === 'en' ? 'en-US' : 'ar-SA');
//console.log('CMS Posts:', entries);

const pageTitle = lang === 'en' ? 'Blog Posts' : 'المقالات';
const pageDescription = lang === 'en' 
  ? 'Latest blog posts and articles' 
  : 'أحدث المقالات والمنشورات';
---

<Layout title={pageTitle} description={pageDescription} lang={lang}>
  <section class="py-32">
    <div class="container flex flex-col items-center gap-16">
      <h1 class="mx-auto mb-3 text-pretty text-center text-2xl font-semibold md:mb-4 md:text-3xl lg:mb-6 lg:max-w-3xl">
        {pageTitle}
      </h1>

      <BlogList posts={entries} lang={lang} />
    </div>
  </section>
</Layout>