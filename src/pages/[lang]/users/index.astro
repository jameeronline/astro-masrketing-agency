---
import { getUsers } from '../../../utils/users';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } }
  ];
}

const { lang } = Astro.params;
const users = await getUsers(lang as 'en' | 'ar');

// Page content based on language
const pageContent = {
  en: {
    title: 'Our Team',
    description: 'Meet our amazing team members',
    role: 'Role',
    contact: 'Contact',
    viewProfile: 'View Profile'
  },
  ar: {
    title: 'فريقنا',
    description: 'تعرف على أعضاء فريقنا الرائعين',
    role: 'الدور',
    contact: 'اتصل',
    viewProfile: 'عرض الملف'
  }
};

const content = pageContent[lang as 'en' | 'ar'];
---

<Layout title={content.title} description={content.description} lang={lang}>
  <div class="container mx-auto px-4 py-8">
    <header class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
        {content.title}
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        {content.description}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {users.map(user => (
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
          {user.avatar && (
            <img 
              src={user.avatar} 
              alt={user.name}
              class="w-full h-48 object-cover"
              loading="lazy"
            />
          )}
          
          <div class="p-6">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
              {user.name}
            </h3>
            
            <p class="text-blue-600 dark:text-blue-400 font-medium mb-3">
              {user.role}
            </p>
            
            {user.bio && (
              <p class="text-gray-600 dark:text-gray-300 mb-4 line-clamp-3">
                {user.bio}
              </p>
            )}
            
            <div class="flex items-center justify-between">
              <a 
                href={`mailto:${user.email}`}
                class="text-sm text-blue-600 dark:text-blue-400 hover:underline"
              >
                {content.contact}
              </a>
              
              <a 
                href={`/${lang}/users/${user.id}`}
                class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200"
              >
                {content.viewProfile}
              </a>
            </div>
            
            {user.social && (
              <div class="flex space-x-3 mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                {user.social.twitter && (
                  <a 
                    href={`https://twitter.com/${user.social.twitter}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-gray-400 hover:text-blue-400 transition-colors"
                    aria-label="Twitter"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"/>
                    </svg>
                  </a>
                )}
                
                {user.social.github && (
                  <a 
                    href={`https://github.com/${user.social.github}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-gray-400 hover:text-gray-700 dark:hover:text-white transition-colors"
                    aria-label="GitHub"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                  </a>
                )}
                
                {user.social.linkedin && (
                  <a 
                    href={`https://linkedin.com/in/${user.social.linkedin}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-gray-400 hover:text-blue-600 transition-colors"
                    aria-label="LinkedIn"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    {users.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-500 dark:text-gray-400 text-lg">
          {lang === 'en' ? 'No users found.' : 'لم يتم العثور على مستخدمين.'}
        </p>
      </div>
    )}
  </div>
</Layout>

<style>
.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>