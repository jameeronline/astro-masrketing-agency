---
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = await useTranslations(lang);

const footerLinks = [
    {
        heading: t('footer.productHeading') ?? 'Product',
        items: [
            { label: t('footer.overview') ?? 'Overview', href: '/overview' },
            { label: t('footer.pricing') ?? 'Pricing', href: '/pricing' },
            { label: t('footer.marketplace') ?? 'Marketplace', href: '/marketplace' },
            { label: t('footer.features') ?? 'Features', href: '/features' },
            { label: t('footer.integrations') ?? 'Integrations', href: '/integrations' },
        ],
    },
    {
        heading: t('footer.companyHeading') ?? 'Company',
        items: [
            { label: t('footer.about') ?? 'About', href: '/about' },
            { label: t('footer.team') ?? 'Team', href: '/team' },
            { label: t('footer.blog') ?? 'Blog', href: '/blog' },
            { label: t('footer.careers') ?? 'Careers', href: '/careers' },
            { label: t('footer.contact') ?? 'Contact', href: '/contact' },
            { label: t('footer.privacy') ?? 'Privacy', href: '/privacy-policy' },
        ],
    },
    {
        heading: t('footer.resourcesHeading') ?? 'Resources',
        items: [
            { label: t('footer.help') ?? 'Help', href: '/help' },
            { label: t('footer.sales') ?? 'Sales', href: '/sales' },
            { label: t('footer.advertise') ?? 'Advertise', href: '/advertise' },
        ],
    },
    {
        heading: t('footer.socialHeading') ?? 'Social',
        items: [
            { label: 'Twitter', href: 'https://twitter.com/yourcompany', external: true },
            { label: 'Instagram', href: 'https://instagram.com/yourcompany', external: true },
            { label: 'LinkedIn', href: 'https://linkedin.com/company/yourcompany', external: true },
        ],
    },
];

---
<section class="py-16 bg-gray-50/50 dark:bg-gray-900">
  <div class="container mx-auto px-4">
    <footer>
      <div class="grid grid-cols-2 gap-8 lg:grid-cols-6">
        <div class="col-span-2 mb-8 lg:mb-0">
          <a href={`/${lang}`}>
            <img src="/logo.svg" alt="logo" class="mb-1 size-16" />
          </a>
          <p class="font-bold">{t('footer.title')}</p>
        </div>

        {footerLinks.map((group) => (
            <div>
                <h3 class="mb-4 font-bold">{group.heading}</h3>
                <ul class="space-y-4 text-gray-600 text-sm">
                    {group.items.map((item) => (
                        <li class="font-medium hover:text-gray-800">
                            {item.external ? (
                                <a href={item.href} target="_blank" rel="noopener">{item.label}</a>
                            ) : (
                                <a href={`/${lang}${item.href}`}>{item.label}</a>
                            )}
                        </li>
                    ))}
                </ul>
            </div>
        ))}
      </div>
      <div
        class="mt-24 flex flex-col justify-between gap-4 border-t pt-8 text-sm font-medium text-gray-600 md:flex-row md:items-center">
        <p>© 2024 Marketing Agency. All rights reserved.</p>
        <ul class="flex gap-4">
          <li class="underline hover:text-gray-800">
            <a href={`/${lang}/terms-and-conditions`}>Terms and Conditions</a>
          </li>
          <li class="underline hover:text-gray-800">
            <a href={`/${lang}/privacy-policy`}>Privacy Policy</a>
          </li>
        </ul>
      </div>
    </footer>
  </div>
</section>